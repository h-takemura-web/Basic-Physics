<!DOCTYPE html>
<html lang="ja">
<head>
    <meta charset="UTF-8">
    <title>物理：放物運動シミュレーター（ベクトル表示・高視認性版）</title>
    <style>
        :root {
            --bg-color: #f0f2f5;
            --panel-bg: #ffffff;
            --accent-blue: #0056b3; /* 濃くしました */
            --accent-red: #c82333;  /* 濃くしました */
            --accent-green: #218838; /* 速度ベクトル用 */
            --accent-black: #212529;
        }
        body { 
            font-family: 'Helvetica Neue', Arial, sans-serif; 
            background-color: var(--bg-color); 
            margin: 0; 
            display: flex; 
            flex-direction: column; 
            align-items: center; 
            height: 100vh;
            overflow: hidden; 
        }
        h1 { font-size: 1.4rem; margin: 10px 0; color: #333; }

        .layout-container { 
            display: flex; 
            flex-direction: row; 
            gap: 20px; 
            padding: 10px; 
            align-items: flex-start;
            justify-content: center;
            width: 95%;
        }

        canvas { 
            background: #fff; 
            border: 2px solid #dee2e6; 
            border-radius: 8px; 
            box-shadow: 0 8px 20px rgba(0,0,0,0.1);
        }
        
        .panel { 
            background: var(--panel-bg); 
            padding: 20px; 
            border-radius: 12px; 
            box-shadow: 0 4px 10px rgba(0,0,0,0.08); 
            width: 320px; 
            display: flex;
            flex-direction: column;
            gap: 12px;
        }

        .control-group { border-bottom: 1px solid #eee; padding-bottom: 8px; }
        label { display: block; font-size: 0.85rem; font-weight: bold; color: #555; margin-bottom: 3px; }
        input[type="range"] { width: 100%; cursor: pointer; }
        .value-display { float: right; color: var(--accent-blue); font-family: 'Courier New', monospace; font-size: 1.1rem; font-weight: bold; }
        
        .btn-group { display: flex; gap: 10px; margin-top: 5px; }
        button { flex: 1; padding: 12px; border: none; border-radius: 6px; font-weight: bold; cursor: pointer; transition: 0.2s; font-size: 1rem; }
        #startBtn { background: var(--accent-blue); color: white; }
        #startBtn:hover { background: #004085; }
        #clearBtn { background: #6c757d; color: white; }

        .legend { font-size: 0.8rem; color: #444; display: flex; flex-direction: column; gap: 6px; margin-top: 10px; }
        .legend-item { display: flex; align-items: center; gap: 10px; }
        .dot { width: 12px; height: 12px; border-radius: 50%; }
        .arrow-icon { font-weight: bold; font-size: 1.2rem; line-height: 1; }
    </style>
</head>
<body>

    <h1>🚀 放物運動シミュレーター</h1>

    <div class="layout-container">
        <canvas id="canvas"></canvas>

        <div class="panel">
            <div class="control-group">
                <label>初速度 $v_0$ <span class="value-display"><span id="v0Val">25</span> m/s</span></label>
                <input type="range" id="v0" min="5" max="60" value="25">
            </div>
            <div class="control-group">
                <label>投射角 $\theta$ <span class="value-display"><span id="angleVal">45</span>°</span></label>
                <input type="range" id="angle" min="-90" max="90" value="45">
            </div>
            <div class="control-group">
                <label>ストロボ間隔 $\Delta t$ <span class="value-display"><span id="dtVal">0.3</span> s</span></label>
                <input type="range" id="dt" min="0.1" max="1.0" step="0.1" value="0.3">
            </div>
            <div class="control-group">
                <label>重力加速度 $g$ <span class="value-display"><span id="gVal">9.8</span> m/s²</span></label>
                <input type="range" id="g" min="0" max="20" step="0.1" value="9.8">
            </div>

            <div class="btn-group">
                <button id="startBtn">投射！</button>
                <button id="clearBtn">リセット</button>
            </div>

            <div class="legend">
                <div class="legend-item"><div class="dot" style="background: var(--accent-black);"></div> 物体（合成運動）</div>
                <div class="legend-item"><div class="dot" style="background: var(--accent-blue);"></div> 水平写像（等速直線運動）</div>
                <div class="legend-item"><div class="dot" style="background: var(--accent-red);"></div> 鉛直写像（鉛直投げ上げ）</div>
                <div class="legend-item"><span class="arrow-icon" style="color: var(--accent-green);">→</span> 速度ベクトル（合成・各成分）</div>
            </div>
        </div>
    </div>

<script>
    const canvas = document.getElementById('canvas');
    const ctx = canvas.getContext('2d');
    
    canvas.width = 800;
    canvas.height = 650;
    const scale = 8; 
    const marginX = 80;
    const projY = 250; 
    const groundY = canvas.height - 40;

    let t = 0;
    let isRunning = false;
    let history = []; 
    let lastStrobeTime = -1;

    // 矢印を描画する補助関数
    function drawArrow(x, y, vx, vy, color) {
        if (Math.abs(vx) < 0.1 && Math.abs(vy) < 0.1) return;
        const arrowScale = 2.0; // 矢印の長さ調整用
        const headlen = 10;
        const tx = x + vx * arrowScale;
        const ty = y - vy * arrowScale; // 画面座標系は下が正なのでvyを引く
        const angle = Math.atan2(-vy, vx);

        ctx.strokeStyle = color;
        ctx.fillStyle = color;
        ctx.lineWidth = 2;

        ctx.beginPath();
        ctx.moveTo(x, y);
        ctx.lineTo(tx, ty);
        ctx.stroke();

        ctx.beginPath();
        ctx.moveTo(tx, ty);
        ctx.lineTo(tx - headlen * Math.cos(angle - Math.PI / 6), ty - headlen * Math.sin(angle - Math.PI / 6));
        ctx.lineTo(tx - headlen * Math.cos(angle + Math.PI / 6), ty - headlen * Math.sin(angle + Math.PI / 6));
        ctx.fill();
    }

    function render() {
        const v0 = parseFloat(document.getElementById('v0').value);
        const theta = parseFloat(document.getElementById('angle').value) * Math.PI / 180;
        const g = parseFloat(document.getElementById('g').value);
        const dt = parseFloat(document.getElementById('dt').value);

        // 現在の物理量
        const vx = v0 * Math.cos(theta);
        const vy = v0 * Math.sin(theta) - g * t;
        const x = vx * t;
        const y = v0 * Math.sin(theta) * t - 0.5 * g * t * t;

        const px = marginX + x * scale;
        const py = projY - y * scale;

        if (py > groundY) isRunning = false;

        if (isRunning && (t - lastStrobeTime >= dt)) {
            if (py <= groundY) {
                history.push({px, py});
                lastStrobeTime = t;
            }
        }

        ctx.clearRect(0, 0, canvas.width, canvas.height);

        // 補助線（背景）
        ctx.strokeStyle = '#eee';
        ctx.beginPath(); ctx.moveTo(marginX-30, projY); ctx.lineTo(canvas.width, projY); ctx.stroke();
        ctx.strokeStyle = '#555';
        ctx.lineWidth = 2;
        ctx.beginPath(); ctx.moveTo(0, groundY); ctx.lineTo(canvas.width, groundY); ctx.stroke();
        ctx.lineWidth = 1;

        // ストロボ（濃く変更）
        history.forEach(p => {
            ctx.fillStyle = 'rgba(0, 86, 179, 0.6)'; // 水平：濃い青
            ctx.beginPath(); ctx.arc(p.px, projY, 4, 0, Math.PI*2); ctx.fill();
            ctx.fillStyle = 'rgba(200, 35, 51, 0.6)'; // 鉛直：濃い赤
            ctx.beginPath(); ctx.arc(marginX, p.py, 4, 0, Math.PI*2); ctx.fill();
            ctx.fillStyle = 'rgba(0, 0, 0, 0.4)';      // 本体：濃いグレー
            ctx.beginPath(); ctx.arc(p.px, p.py, 3, 0, Math.PI*2); ctx.fill();
        });

        if (isRunning || t > 0) {
            // 補助線
            ctx.setLineDash([5, 5]);
            ctx.strokeStyle = '#aaa';
            ctx.beginPath(); ctx.moveTo(px, py); ctx.lineTo(px, projY); ctx.stroke();
            ctx.beginPath(); ctx.moveTo(px, py); ctx.lineTo(marginX, py); ctx.stroke();
            ctx.setLineDash([]);

            // 速度ベクトル（緑）
            drawArrow(px, py, vx, vy, 'var(--accent-green)'); // 合成速度
            drawArrow(px, projY, vx, 0, 'var(--accent-blue)');  // 水平速度成分
            drawArrow(marginX, py, 0, vy, 'var(--accent-red)');   // 鉛直速度成分

            // 現在位置の点（濃く表示）
            ctx.fillStyle = 'var(--accent-blue)';
            ctx.beginPath(); ctx.arc(px, projY, 8, 0, Math.PI*2); ctx.fill();
            ctx.fillStyle = 'var(--accent-red)';
            ctx.beginPath(); ctx.arc(marginX, py, 8, 0, Math.PI*2); ctx.fill();
            ctx.fillStyle = 'var(--accent-black)';
            ctx.beginPath(); ctx.arc(px, py, 11, 0, Math.PI*2); ctx.fill();
        }

        if (isRunning) {
            t += 0.016;
            requestAnimationFrame(render);
        }
    }

    document.getElementById('startBtn').addEventListener('click', () => {
        t = 0; lastStrobeTime = -0.0001; history = []; isRunning = true;
        render();
    });

    document.getElementById('clearBtn').addEventListener('click', () => {
        t = 0; isRunning = false; history = [];
        render();
    });

    document.querySelectorAll('input[type="range"]').forEach(el => {
        el.oninput = (e) => {
            document.getElementById(e.target.id + 'Val').innerText = e.target.value;
            if (!isRunning) { t = 0; history = []; render(); }
        };
    });

    render();
</script>
</body>
</html>
